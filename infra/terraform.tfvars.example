project_id = "my-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

# SSH public key for VM access (paste contents of ~/.ssh/id_ed25519.pub)
ssh_pub_key = "ssh-ed25519 AAAA..."
ssh_user    = "deploy"

# Git repo URL (must be publicly accessible, or use a deploy key)
repo_url = "https://github.com/youruser/swimplan.git"

# Google OAuth credentials (from Google Cloud Console)
google_client_id     = "123456789.apps.googleusercontent.com"
google_client_secret = "GOCSPX-..."

# JWT signing secret (generate with: openssl rand -hex 32)
jwt_secret = "change-me-to-a-random-string"
